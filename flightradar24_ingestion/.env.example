# Copy to .env and fill in
# Get your token from https://fr24api.flightradar24.com → Key management
FR24_API_TOKEN=your_api_token_here
# Optional: use sandbox for testing without spending credits
# Sandbox base still uses same host, but with sandbox token
FR24_USE_SANDBOX=false
FR24_API_VERSION=v1

# Google Sheet target (optional - pipeline can create one)
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Flights
